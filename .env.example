# Copy to `.env` (repo root) and fill in real values. The server reads `.env`
# on startup — NOT this file. Never put a real token in `.env.example`; it is
# a committed template.

# --- Core ------------------------------------------------------------------
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
RECONNECT_GRACE_MS=120000
TURN_TIMEOUT_SECONDS=90
EMPTY_ROOM_TTL_MS=900000
BOT_THINK_MS=1200

# --- Sharing over the internet (ngrok) -----------------------------------
# `pnpm share` builds the client and opens a public ngrok tunnel, printing the
# invite link in the terminal.
#
# Get a free token at https://dashboard.ngrok.com/get-started/your-authtoken
# and put it in your `.env` (this is the ONLY thing that works — the SDK does
# not read the `ngrok config add-authtoken` CLI file):
# NGROK_AUTHTOKEN=your_token_here
#
# Optional reserved domain (paid ngrok) so the link stays the same each run:
# NGROK_DOMAIN=my-game.ngrok.app
